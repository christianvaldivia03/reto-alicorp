# URL base del backend FastAPI, incluye el prefijo /api/v1.
# En local, el backend corre en el puerto 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# (Opcional) URL del proyecto de Langfuse. Si se define, el Superadmin ve un
# enlace "Observabilidad" hacia el panel de trazas. Déjala vacía para ocultarlo.
NEXT_PUBLIC_LANGFUSE_URL=
