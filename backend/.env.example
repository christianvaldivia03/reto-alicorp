# App — usa "production" en Render para ocultar Swagger/ReDoc/OpenAPI.
APP_ENV=local

# Orígenes permitidos por CORS (coma-separado). En prod, la URL del frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3123

# Supabase (Fase 1+)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Modelos
GROQ_API_KEY=
GOOGLE_API_KEY=

# Auth — genera un valor real en producción
JWT_SECRET=dev-secret-change-me
JWT_TTL_MIN=120

# Langfuse (Fase 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
